# Career service (former FlacronCV V2 features, integrated into V1). Names only.
# Copy to .env.career (git-ignored) at the repository root. apps/career-api and
# apps/career-worker read ONLY that file; they never read apps/api/.env or a root .env.
# Do not put live keys, connection strings, or customer data in this file.

NODE_ENV=
# Local default 4101 (V1 API keeps 4000).
PORT=
# Career Postgres. Local runs and tests refuse any host other than localhost/127.0.0.1.
DATABASE_URL=
# V1 web origins allowed to call the career API, comma-separated.
CORS_ORIGINS=
# Worker only. Schema pg-boss uses. Empty means pgboss.
PGBOSS_SCHEMA=

# --- Identity and the V1 plan bridge -------------------------------------
# Production: V1's Firebase project (the only accepted value). Local: a demo- project
# id shared with the Auth + Firestore emulators.
FIREBASE_PROJECT_ID=
# Local only. Required in development; refused in a hosted deployment.
FIREBASE_AUTH_EMULATOR_HOST=
# Local only. Required outside a hosted deployment so V1 production data cannot be read.
FIRESTORE_EMULATOR_HOST=
# firestore (default) reads V1 users/{uid} read-only. static is for automated tests only.
V1_ACCOUNT_SOURCE=
# Hosted only, when no runtime role/ADC is available: a READ-ONLY credential for V1 Firestore.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# CLIENT DECISION. Which career allowance each V1 plan receives, e.g.
#   free:none,pro:professional,career_accelerator:none,enterprise:career_pro
# Omitted or none = career features off for that plan. Empty = off for everyone.
CAREER_PLAN_MAP=
# Comma-separated Firebase uids allowed to use the career operator tools (moderation,
# feature switches), in addition to V1 accounts holding the admin/super_admin claim.
ADMIN_AUTH_USER_IDS=

# --- Providers (each stays unavailable when empty) -----------------------
OPENAI_API_KEY=
# Optional chat model (default gpt-4o-mini; snapshot shutdown 14 Jan 2027). Test before switching.
OPENAI_TEXT_MODEL=
# openai binds OpenAITextModel. Empty keeps UnconfiguredTextModel (requests fail and release credits).
AI_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_PROVIDER=
# record stores mail locally. sandbox sends only to @example.test through SES.
MAIL_DELIVERY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_REPLY_TO=
# local writes under OBJECT_STORAGE_DIR (signed links need OBJECT_STORAGE_SECRET);
# s3 uses OBJECT_STORAGE_BUCKET (a dedicated private career bucket) with the runtime role.
OBJECT_STORAGE=
OBJECT_STORAGE_DIR=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_KMS_KEY_ID=
EVIDENCE_UPLOAD_MAX_BYTES=

# Hosted only: staging or production. Leave empty locally.
DEPLOY_ENV=
MAIL_ALLOWED_RECIPIENTS=
# V1 owns billing: STRIPE_SECRET_KEY is refused in production and unused everywhere.
