{
  "name": "flacroncv",
  "version": "1.0.0",
  "description": "Automation testing of Flacron CV application",
  "homepage": "https://github.com/Flacron-Enterprises-llc/FlacronCV#readme",
  "bugs": {
    "url": "https://github.com/Flacron-Enterprises-llc/FlacronCV/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flacron-Enterprises-llc/FlacronCV.git"
  },
  "license": "ISC",
  "author": "Hina Sarmad",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:landingPage-test": "npx cypress run --browser chrome  --spec cypress/e2e/tests/landingPage.cy.js",
    "test:signUpPage-test": "npx cypress run --browser chrome  --spec cypress/e2e/tests/SignUp/signUpTestPage.cy.js",
    "test:loginPage-test": "npx cypress run --browser chrome  --spec cypress/e2e/tests/login.cy.js",
    "test:createNewCV-test": "npx cypress run --browser chrome  --spec cypress/e2e/tests/skillsPageTest.cy.js",
    "test:myCVPage-test": "npx cypress run --browser chrome  --spec cypress/e2e/tests/myCV.cy.js",
    "test": "npx cypress run --record --key 757222a2-1275-4e82-b3f3-bf3bdf69552a"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@simonsmith/cypress-image-snapshot": "^10.0.3",
    "cypress": "^15.9.0",
    "cypress-mailslurp": "^1.11.1",
    "cypress-mochawesome-reporter": "^4.0.2"
  },
  "dependencies": {
    "cypress-plugin-steps": "^1.2.1",
    "cypress-slow-down": "^1.3.1",
    "mammoth": "^1.12.0",
    "pdf-extraction": "^1.0.2",
    "pdf-parse": "^2.4.5"
  }
}
