# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated additional allowed CORS origins (e.g. preview deploys)
ADDITIONAL_ORIGINS=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# IBM WatsonX
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs
#
# The *_YEARLY_* entries must point at a Stripe price whose recurring interval
# is literally "year". A price id does not encode its interval, so a
# month-interval price sits here perfectly happily and bills twelve times too
# often — which is a refund and a chargeback, not a bug report. This has already
# happened once in this project: both YEARLY ids pointed at MONTH-interval
# prices ($359.99/mo and $1,199.00/mo) while the page advertised $299.99 and
# $999.99 per year.
#
# Before setting YEARLY_BILLING_ENABLED=true in
# packages/shared-types/src/subscription.types.ts, run:
#     node scripts/verify-yearly-prices.mjs
# which asks Stripe what each id actually is and refuses to green-light a
# mismatch.
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxx

# AWS SES (transactional email) — powers verification, password-reset, welcome,
# lead-confirmation, and contact-form emails. Bodies are rendered in MailService
# as inline HTML, so there are no provider-side template IDs.
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset on AWS-hosted
# environments to use the instance/task IAM role instead of static keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=no-reply@flacronenterprises.com
SES_FROM_NAME=FlacronAI
SES_REPLY_TO=support@flacronenterprises.com
# Inbox for public contact-form submissions (defaults to SES_REPLY_TO)
CONTACT_EMAIL=support@flacronenterprises.com

# NOTE: WATSONX_* below is an experimental fallback AI provider that is NOT wired
# into config/configuration.ts — OpenAI is the active provider. Leave blank unless
# you complete the WatsonX wiring.

# ── Local Firebase Emulators (optional — safe local QA) ──────────────────────
# Uncomment BOTH to route the API at the local emulators instead of the LIVE
# project. See "Local testing with Firebase Emulators" in the root README.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
