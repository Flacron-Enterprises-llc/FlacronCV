{
  "expo": {
    "name": "FlacronCV",
    "slug": "flacroncv-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flacroncv.mobile",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.flacroncv.mobile",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FlacronCV uses your photo library so you can choose a profile photo and attach photos of certificates or other proof of your work.",
          "cameraPermission": false,
          "microphonePermission": "FlacronCV uses your microphone only when you choose to record an interview practice answer. The recording is saved on your account and you can remove it at any time."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-iap",
      [
        "expo-audio",
        {
          "microphonePermission": "FlacronCV uses your microphone only when you choose to record an interview practice answer. The recording is saved on your account and you can remove it at any time.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/with-optional-screen-features",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset"
    ],
    "scheme": [
      "flacroncv",
      "com.flacroncv.mobile"
    ],
    "extra": {
      "eas": {
        "projectId": "22f570f5-66a6-4e24-a606-1f90e4a2109a"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "flacron-enterprises-llc"
  }
}
