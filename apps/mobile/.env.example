# API
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# App
EXPO_PUBLIC_APP_NAME=FlacronCV
EXPO_PUBLIC_APP_URL=https://flacroncv.com

# Paid upgrades (Stripe Checkout in the browser). Omit to use
# src/config/paid-upgrades.ts per-platform defaults (all off).
# true = today's checkout UI. Do not ship an iOS App Store build with true.
# EXPO_PUBLIC_PAID_UPGRADES_ENABLED=false

# Career tools (integrated V2 service, optional add-on). Off unless true.
# Read docs/V2_INTEGRATION.md "Mobile and the app stores" before an iOS release with true:
# the add-on is not yet an in-app purchase (Apple 3.1.3(b)).
# EXPO_PUBLIC_CAREER_ENABLED=false
# Career API origin (routes under /api/career/v1). A LAN/localhost value is refused in release builds.
# EXPO_PUBLIC_CAREER_API_URL=http://localhost:4101

# Local development only (ignored in release builds): Firebase Auth emulator, e.g. 10.0.2.2:9150
# from an Android emulator, or <laptop LAN IP>:9150 from a phone.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
