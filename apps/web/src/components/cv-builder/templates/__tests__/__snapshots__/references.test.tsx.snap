ght:1px;background:#e2e5ea"></div><div style="height:2px;width:34px;background:#1e3a5f;margin-top:-1px"></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:14px;font-weight:600;color:#111827;line-height:1.3">Lead Engineer</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">Jan 2020 – Present</span></div><p style="font-size:12px;font-weight:500;color:#4b5563;margin:3px 0 0">Acme · Remote</p><p style="font-size:11px;color:#374151;margin-top:5px;margin-bottom:0;line-height:1.65;word-break:break-word;overflow-wrap:break-word;white-space:pre-line">Led the platform team.
Shipped v2.</p></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:14px;font-weight:600;color:#111827;line-height:1.3">Engineer</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">Mar 2017 – Dec 2019</span></div><p style="font-size:12px;font-weight:500;color:#4b5563;margin:3px 0 0">Initech</p></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:14px;font-weight:600;color:#111827;line-height:1.3">Freelancer</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">Present</span></div><p style="font-size:12px;font-weight:500;color:#4b5563;margin:3px 0 0"></p></div></div><div style="margin-bottom:18px"><div style="margin-bottom:9px;position:relative"><h2 style="font-family:var(--font-inter);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-top:0;margin-bottom:0;font-size:13px;color:#1e3a5f;padding-bottom:5px">Education</h2><div style="height:1px;background:#e2e5ea"></div><div style="height:2px;width:34px;background:#1e3a5f;margin-top:-1px"></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:14px;font-weight:600;color:#111827;line-height:1.3">BSc in Computer Science</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">2013 – 2017</span></div><p style="font-size:12px;font-weight:500;color:#4b5563;margin:3px 0 0">State University</p><p style="font-size:11px;color:#374151;margin-top:5px;margin-bottom:0;line-height:1.6;word-break:break-word;overflow-wrap:break-word;white-space:pre-line">Honours</p></div></div><div style="margin-bottom:18px"><div style="margin-bottom:9px;position:rel