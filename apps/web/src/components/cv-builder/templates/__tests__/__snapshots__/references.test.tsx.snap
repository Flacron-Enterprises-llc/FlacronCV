ound:#e2e5ea"></div><div style="height:2px;width:34px;background:#1e3a5f;margin-top:-1px"></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:12px;font-weight:600;color:#111827;line-height:1.3">On Things</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">2020</span></div><p style="font-size:11px;color:#374151;margin-top:3px;margin-bottom:0;line-height:1.55;word-break:break-word;overflow-wrap:break-word;white-space:pre-line">Journal of Things</p></div></div><div style="margin-bottom:18px"><div style="margin-bottom:9px;position:relative"><h2 style="font-family:var(--font-inter);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-top:0;margin-bottom:0;font-size:13px;color:#1e3a5f;padding-bottom:5px">Custom</h2><div style="height:1px;background:#e2e5ea"></div><div style="height:2px;width:34px;background:#1e3a5f;margin-top:-1px"></div></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:12px;font-weight:600;color:#111827;line-height:1.3">Side note</span><span style="font-size:10px;font-weight:500;letter-spacing:0.2px;color:#6b7280;white-space:nowrap;flex-shrink:0">Feb 2024</span></div><p style="font-size:11px;color:#374151;margin-top:3px;margin-bottom:0;line-height:1.55;word-break:break-word;overflow-wrap:break-word;white-space:pre-line">Body text</p></div><div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px"><span style="font-size:12px;font-weight:600;color:#111827;line-height:1.3">Named custom</span></div></div></div></div>"
