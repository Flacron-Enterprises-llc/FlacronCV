{
  "name": "career-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs on pg-boss. No public routes.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "check": "tsx src/main.ts --check",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ],
    "testTimeout": 60000,
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "@flacroncv/career-server": "workspace:*",
    "pg": "^8.13.0",
    "pg-boss": "^10.4.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
