{
  "name": "@flacroncv/career-server",
  "version": "0.0.0",
  "private": true,
  "description": "Server-only code shared by apps/api and apps/worker: env loading, database schema, billing core. Not for web or mobile.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@flacroncv/career-shared": "workspace:*",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "1.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/testing/setup-env.ts"
    ],
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
